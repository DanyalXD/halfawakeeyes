{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tickets/index.html",
        "destination": "/tickets/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/shows/**",
        "function": {
          "functionId": "getPublicEventPage",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public-links",
        "function": {
          "functionId": "getPublicLinksJson",
          "region": "us-central1"
        }
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ]
  }
}
