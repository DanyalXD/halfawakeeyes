{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/join",
        "destination": "/join-us/",
        "type": 301
      },
      {
        "source": "/join/",
        "destination": "/join-us/",
        "type": 301
      },
      {
        "source": "/join/index.html",
        "destination": "/join-us/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tickets/index.html",
        "destination": "/tickets/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/shows/**",
        "function": {
          "functionId": "getPublicEventPage",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public-links",
        "function": {
          "functionId": "getPublicLinksJson",
          "region": "us-central1"
        }
      },
      {
        "source": "/smartlink",
        "destination": "/smartlink.html"
      },
      {
        "source": "/smartlink/**",
        "destination": "/smartlink.html"
      },
      {
        "source": "/unsubscribe",
        "function": {
          "functionId": "emailUnsubscribe",
          "region": "us-central1"
        }
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "firestore.rules",
      "firestore.indexes.json"
    ]
  }
}
